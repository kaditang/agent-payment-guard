{
  "name": "@kaditang/agent-payment-guard",
  "version": "0.3.1",
  "description": "Pre-pay risk gate for autonomous payment agents \u2014 drops onto the x402 payment path itself (x402-fetch / x402-axios), so every 402 is vetted before your agent signs. Blocks payTo swaps, overcharges, budget drains and prompt-injected destinations. Backed by 402Sentinel.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./guard": "./guard.mjs",
    "./sentinel": "./sentinel.mjs",
    "./x402": "./x402.mjs",
    "./policy": "./policy.mjs"
  },
  "bin": {
    "agent-payment-guard": "demo.mjs"
  },
  "files": [
    "index.mjs",
    "guard.mjs",
    "sentinel.mjs",
    "x402.mjs",
    "policy.mjs",
    "agent-sdk-hook.ts",
    "demo.mjs",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "demo": "node demo.mjs",
    "demo:live": "node demo.mjs --live",
    "test": "node --test"
  },
  "keywords": [
    "x402",
    "ai-agent",
    "agent-payments",
    "payment-firewall",
    "prompt-injection",
    "guardrail",
    "mcp",
    "claude-agent-sdk",
    "agentkit",
    "counterparty-risk",
    "402sentinel",
    "usdc",
    "autonomous-payments",
    "x402-fetch",
    "x402-axios",
    "payto-pinning"
  ],
  "homepage": "https://402sentinel.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaditang/agent-payment-guard.git"
  },
  "author": "kaditang",
  "license": "MIT",
  "peerDependencies": {
    "@x402/core": "*",
    "@x402/evm": "*",
    "viem": "*"
  },
  "peerDependenciesMeta": {
    "@x402/core": {
      "optional": true
    },
    "@x402/evm": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@x402/core": "^2.24.0",
    "@x402/fetch": "^2.24.0",
    "axios": "^1.20.0",
    "x402-axios": "1.2.0",
    "x402-fetch": "^1.2.0"
  }
}
